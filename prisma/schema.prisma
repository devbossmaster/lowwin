generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String                 @id
  name                String
  email               String?                @unique
  emailVerified       Boolean                @default(false)
  role                String                 @default("member")
  image               String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  telegramId          String?                @unique
  telegramUsername    String?
  telegramPhoneNumber String?
  accounts            Account[]
  sessions            Session[]
  wallet              Wallet?
  ownContact          TelegramOwnContact?
  operations          Operation[]
  topups              TopUpIntent[]
  bids                Bid[]
  wonSettlements      AuctionSettlement[]    @relation("SettlementWinner")
  settlementMovements SettlementMovement[]
  playerProfile       PlayerProfile?
  favorites           AuctionFavorite[]
  staffMember         StaffMember?
  testRunActors       TestRunActor[]
  arifPayCheckouts     ArifPayCheckout[]
  chapaCheckouts       ChapaCheckout[]
  referralInvite      ReferralInvite?
  referralSignups     ReferralSignup[]       @relation("ReferralSponsor")
  referredSignup      ReferralSignup?        @relation("ReferralNewUser")
  pendingReferrals    ReferralPendingSignup[] @relation("PendingReferralSponsor")
  consumedReferral    ReferralPendingSignup? @relation("PendingReferralUser")
  referralCoupons     ReferralCoupon[]
  referralRedemptions ReferralRedemption[]
  referralRegistrationProof ReferralRegistrationProof?
  winnerPhotoConsents WinnerPresentation[] @relation("WinnerPhotoConsent")

  @@map("user")
}

model Session {
  id               String        @id
  token            String        @unique
  expiresAt        DateTime
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  ipAddress        String?
  userAgent        String?
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  staffSession     StaffSession?
  telegramLaunchId String?

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  telegramId            String?
  telegramUsername      String?

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

model TelegramOwnContact {
  id             String    @id @default(uuid())
  telegramId     String
  botId          String
  userId         String?   @unique
  user           User?     @relation(fields: [userId], references: [id], onDelete: Restrict)
  phoneHash      String    @unique
  phoneCipher    String
  lastFour       String
  verifiedAt     DateTime
  sourceUpdateId BigInt    @unique
  revokedAt      DateTime?

  @@unique([botId, telegramId])
}

model ContactEvent {
  id         String   @id @default(uuid())
  botId      String
  telegramId String
  updateId   BigInt   @unique
  outcome    String
  createdAt  DateTime @default(now())
}

model Wallet {
  id                  String               @id @default(uuid())
  userId              String               @unique
  user                User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  accounts            LedgerAccount[]
  holds               AuctionHold[]
  holdGuard           WalletHoldGuard?
  settlementMovements SettlementMovement[]
  createdAt           DateTime             @default(now())
}

// Audited display/accounting unit transition. Existing integer ledger rows are
// preserved; all accepted amounts map to whole ETB at 1:1.
model CurrencyConversion {
  id          String   @id
  fromUnit    String
  toUnit      String
  numerator   BigInt
  denominator BigInt
  effectiveAt DateTime @default(dbgenerated("(clock_timestamp() AT TIME ZONE 'UTC')")) @db.Timestamp(6)
  reason      String
}

// Internal serialization row; maintained by the hold-integrity migration.
model WalletHoldGuard {
  walletId String @id
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)
  revision BigInt @default(0)
}

model LedgerAccount {
  id       String    @id @default(uuid())
  name     String    @unique
  kind     String
  walletId String?
  wallet   Wallet?   @relation(fields: [walletId], references: [id], onDelete: Restrict)
  balance  Decimal   @default(0) @db.Decimal
  postings Posting[]

  @@unique([walletId, kind])
}

model Journal {
  id            String    @id @default(uuid())
  operationId   String    @unique
  operation     Operation @relation(fields: [operationId], references: [id], onDelete: Restrict)
  kind          String
  reference     String
  createdAt     DateTime  @default(now())
  transactionId BigInt    @default(dbgenerated("txid_current()"))
  postings      Posting[]
  chapaCheckout ChapaCheckout?
}

model Posting {
  id        String        @id @default(uuid())
  journalId String
  journal   Journal       @relation(fields: [journalId], references: [id], onDelete: Restrict)
  accountId String
  account   LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  delta     Decimal       @db.Decimal

  @@unique([journalId, accountId])
  @@index([accountId])
}

model Operation {
  id                 String               @id @default(uuid())
  userId             String
  user               User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  scope              String
  key                String
  requestHash        String
  result             Json
  createdAt          DateTime             @default(now())
  journal            Journal?
  bid                Bid?
  settlementCharges  SettlementMovement[] @relation("SettlementCharge")
  settlementReleases SettlementMovement[] @relation("SettlementRelease")
  settlementRefunds  SettlementMovement[] @relation("SettlementRefund")
  referralRedemption ReferralRedemption?

  @@unique([userId, scope, key])
  @@index([scope, requestHash, createdAt])
}

model Category {
  id                        String    @id @default(uuid())
  version                   Int       @default(1)
  slug                      String    @unique
  name                      String    @unique
  nameAm                    String?
  description               String
  descriptionAm             String?
  sortOrder                 Int       @default(0)
  visible                   Boolean   @default(true)
  requiresEligibilityReview Boolean   @default(false)
  products                  Product[]
  auctions                  Auction[]

  @@index([visible, sortOrder])
}

model Product {
  id          String         @id @default(uuid())
  version     Int            @default(1)
  slug        String         @unique
  title       String
  titleAm     String?
  description String
  descriptionAm String?
  condition   String
  conditionAm String?
  categoryId  String
  category    Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  visible     Boolean        @default(true)
  isDemo      Boolean        @default(false)
  testRunId   String?
  testRun     TestRun?       @relation(fields: [testRunId], references: [id], onDelete: Restrict)
  images      ProductImage[]
  auctions    Auction[]

  @@index([categoryId, visible])
  @@index([testRunId])
}

model ProductImage {
  id           String  @id @default(uuid())
  productId    String
  product      Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  path         String
  alt          String
  sourceType   String  @default("ORIGINAL")
  sourceCredit String?
  sortOrder    Int     @default(0)

  @@unique([productId, sortOrder])
}

// Preserve the original id, code, and holds relationship from Phase 1.5.
model Auction {
  id                  String                   @id @default(uuid())
  code                String                   @unique
  publicCode          Int                      @unique @default(autoincrement())
  holds               AuctionHold[]
  bids                Bid[]
  slug                String?                  @unique
  productId           String?
  product             Product?                 @relation(fields: [productId], references: [id], onDelete: Restrict)
  categoryId          String?
  category            Category?                @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  status              String                   @default("DRAFT")
  startsAt            DateTime?
  endsAt              DateTime?
  publishedAt         DateTime?
  featured            Boolean                  @default(false)
  isDemo              Boolean                  @default(false)
  testRunId           String?
  testRun             TestRun?                 @relation(fields: [testRunId], references: [id], onDelete: Restrict)
  controlVersion      Int                      @default(0)
  // Per-auction public copy and images. This lets staff correct presentation
  // mistakes without changing the promised product or frozen bidding rules.
  presentation        Json?
  acceptedBidCount    Int                      @default(0)
  bidSequence         BigInt                   @default(0)
  // Aggregate public impressions only. Viewer identity is never stored.
  publicViewCount     BigInt                   @default(0)
  fulfillmentSummary  String?
  fulfillmentSummaryAm String?
  fulfillmentRegion   String?
  fulfillmentRegionAm String?
  terms               AuctionTerms?
  result              PublicAuctionResult?
  settlement          AuctionSettlement?
  winnerPresentation  WinnerPresentation?
  // Explicit opt-in for freshly scheduled local DEMO fixtures; old seeds stay false.
  isSettlementFixture Boolean                  @default(false)
  closeAttempts       Int                      @default(0)
  nextCloseAttemptAt  DateTime?
  closeErrorCode      String?
  favorites           AuctionFavorite[]
  draft               AuctionDraft?
  feeRevisions        AuctionFeeRevision[]
  controlRevisions    AuctionControlRevision[]
  arifPayCheckouts     ArifPayCheckout[]
  chapaCheckouts       ChapaCheckout[]

  @@index([status, startsAt, endsAt])
  @@index([categoryId, status])
  @@index([publishedAt, endsAt])
  @@index([testRunId, status])
}

// One immutable published snapshot per auction. A later policy change creates
// a replacement auction; the version field defines the contract for readers.
model AuctionTerms {
  id                   String    @id @default(uuid())
  auctionId            String    @unique
  auction              Auction   @relation(fields: [auctionId], references: [id], onDelete: Restrict)
  version              Int       @default(1)
  ruleVersion          String    @default("lowest-unique-v1")
  minParticipants      Int       @default(0)
  minPoints            Decimal   @db.Decimal
  maxPoints            Decimal?  @db.Decimal
  stepPoints           Decimal   @db.Decimal
  entryFeePoints       Decimal   @default(0) @db.Decimal
  maxDistinctBids      Int       @default(100)
  noWinnerTerms        String
  cancellationTerms    String
  fulfillmentSnapshot  String
  publishedEndsAt      DateTime?
  maxExtensionMinutes  Int       @default(10080)
  allowPaidShortening  Boolean   @default(false)
  shortenNoticeMinutes Int       @default(1440)
  createdAt            DateTime  @default(now())
}

// Immutable fee schedule. Existing bids retain the revision and exact fee that
// were accepted; changing a live fee only appends a revision for future bids.
model AuctionFeeRevision {
  id           String   @id @default(uuid())
  auctionId    String
  auction      Auction  @relation(fields: [auctionId], references: [id], onDelete: Restrict)
  version      Int
  feePoints    Decimal  @db.Decimal
  effectiveAt  DateTime @default(dbgenerated("(clock_timestamp() AT TIME ZONE 'UTC')")) @db.Timestamp(6)
  actorId      String?
  reason       String
  operationKey String?  @unique
  bids         Bid[]

  @@unique([auctionId, version])
  @@index([auctionId, effectiveAt])
}

// Append-only administrative history for live presentation and schedule edits.
model AuctionControlRevision {
  id           String   @id @default(uuid())
  auctionId    String
  auction      Auction  @relation(fields: [auctionId], references: [id], onDelete: Restrict)
  version      Int
  kind         String
  before       Json
  after        Json
  actorId      String
  reason       String
  operationKey String   @unique
  createdAt    DateTime @default(dbgenerated("(clock_timestamp() AT TIME ZONE 'UTC')")) @db.Timestamp(6)

  @@unique([auctionId, version])
  @@index([auctionId, createdAt])
}

model PublicAuctionResult {
  id            String   @id @default(uuid())
  auctionId     String   @unique
  auction       Auction  @relation(fields: [auctionId], references: [id], onDelete: Restrict)
  outcome       String
  winningPoints Decimal? @db.Decimal
  winnerLabel   String?
  explanation   String
  closedAt      DateTime
  isDemo        Boolean  @default(false)
  publishedAt   DateTime @default(now())
}

model AuctionHold {
  id        String   @id @default(uuid())
  walletId  String
  wallet    Wallet   @relation(fields: [walletId], references: [id], onDelete: Restrict)
  auctionId String
  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: Restrict)
  points    Decimal  @default(0) @db.Decimal
  updatedAt DateTime @updatedAt

  @@unique([walletId, auctionId])
}

// Accepted bids are immutable audit facts. The database sets acceptedAt after
// the auction row lock is acquired, never from client or application time.
model Bid {
  id                String              @id @default(uuid())
  userId            String
  user              User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  auctionId         String
  auction           Auction             @relation(fields: [auctionId], references: [id], onDelete: Restrict)
  amount            Decimal             @db.Decimal
  acceptedAt        DateTime            @default(dbgenerated("(clock_timestamp() AT TIME ZONE 'UTC')")) @db.Timestamp(6)
  acceptanceOrder   BigInt?
  termsVersion      Int
  feePoints         Decimal             @db.Decimal
  feeRevisionId     String?
  feeRevision       AuctionFeeRevision? @relation(fields: [feeRevisionId], references: [id], onDelete: Restrict)
  operationId       String              @unique
  operation         Operation           @relation(fields: [operationId], references: [id], onDelete: NoAction)
  winningSettlement AuctionSettlement?
  referralSignup    ReferralSignup?       @relation("ReferralFirstBid")
  referralRedemption ReferralRedemption?
  chapaCheckout     ChapaCheckout?

  @@unique([userId, auctionId, amount])
  @@unique([auctionId, acceptanceOrder])
  @@index([userId, auctionId, acceptedAt])
  @@index([auctionId, amount])
  @@index([feeRevisionId])
}

// Additive direct bid-fee checkout. Existing wallets and transfer records remain intact.
model ArifPayCheckout {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  auctionId         String
  auction           Auction   @relation(fields: [auctionId], references: [id], onDelete: Restrict)
  auctionSlug       String
  key               String
  requestHash       String
  bidNumber         Decimal   @db.Decimal
  feeVersion        Int
  fee               Decimal   @db.Decimal
  currency          String    @default("ETB")
  channel           String
  phoneCipher       String
  phoneHash         String
  nonce             String    @unique
  sessionId         String?   @unique
  transactionId     String?   @unique
  status            String    @default("SUBMITTING")
  reason            String?
  creditJournalId   String?   @unique
  bidId             String?   @unique
  receipt           Json?
  evidenceHash      String?
  attempts          Int       @default(0)
  nextCheckAt       DateTime  @default(now())
  expiresAt         DateTime
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([userId, key])
  @@index([status, nextCheckAt])
  @@index([userId, createdAt])
}

// Hosted Chapa v2 attempts are additive; verified funds use the existing ledger.
// Purpose, environment, expected cents and source auction quote are immutable.
model ChapaCheckout {
  id                    String    @id @default(uuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  purpose               String
  mode                  String
  credentialFingerprint String
  key                   String
  requestHash           String
  initialization        Json
  phoneCipher           String?
  phoneBotId            String?
  merchantReference     String    @unique
  chapaReference        String?   @unique
  checkoutUrl           String?
  amountCents           BigInt
  currency              String    @default("ETB")
  auctionId             String?
  auction               Auction?  @relation(fields: [auctionId], references: [id], onDelete: Restrict)
  auctionSlug           String?
  bidNumber             Decimal?  @db.Decimal
  feeVersion            Int?
  grossFee              Decimal?  @db.Decimal
  discountPoints        Decimal   @default(0) @db.Decimal
  // A quote snapshot only. Redemption remains owned by the referral command.
  couponId              String?
  status                String    @default("SUBMITTING")
  flowVersion           Int       @default(2)
  providerStatus        String?
  verificationState     String    @default("UNVERIFIED")
  initializationErrorCode String?
  initializationHttpStatus Int?
  reason                String?
  creditJournalId       String?   @unique
  creditJournal         Journal?  @relation(fields: [creditJournalId], references: [id], onDelete: Restrict)
  bidId                 String?   @unique
  bid                   Bid?      @relation(fields: [bidId], references: [id], onDelete: Restrict)
  receipt               Json?
  evidenceHash          String?
  paymentMethod         String?
  processorReference    String?
  serviceFeeCents       BigInt?
  attempts              Int       @default(0)
  nextCheckAt           DateTime  @default(now())
  leaseUntil            DateTime?
  expiresAt             DateTime
  providerCreatedAt     DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([userId, key])
  @@index([status, nextCheckAt])
  @@index([userId, createdAt])
}

// Authenticated delivery hashes are durable hints, never payment authority.
// No webhook body, customer contact or provider secret is retained here.
model ChapaWebhookEvent {
  id                       String   @id @default(uuid())
  mode                     String
  configurationFingerprint String
  bodyHash                 String
  merchantReference        String?
  chapaReference           String?
  event                    String
  checkoutId               String?
  status                   String   @default("QUEUED")
  attempts                 Int      @default(0)
  nextAttemptAt            DateTime @default(now())
  leaseUntil               DateTime?
  completedAt              DateTime?
  receivedAt               DateTime @default(now())

  @@unique([mode, configurationFingerprint, bodyHash])
  @@index([merchantReference, receivedAt])
  @@index([status, nextAttemptAt])
}

model TopUpIntent {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  key               String
  provider          String
  providerIntentId  String?
  status            String    @default("PENDING")
  points            Decimal   @db.Decimal
  policyVersion     String
  journalId         String?   @unique
  createdAt         DateTime  @default(now())
  channel           String?
  expectedCents     BigInt?
  amountFromReceipt Boolean   @default(false)
  receivingAccount  String?
  accountName       String?
  quoteSnapshot     Json?
  requestHash       String?
  expiresAt         DateTime?
  reference         String?
  attempts          Int       @default(0)
  scanAttempts      Int       @default(0)
  nextAttemptAt     DateTime  @default(now())
  leaseToken        String?
  leaseUntil        DateTime?
  reasonCode        String?
  caseState         String    @default("OPEN")
  assignedTo        String?
  verifyRequests    VerifyRequest[]

  @@unique([userId, key])
  @@unique([provider, providerIntentId])
  @@index([status, createdAt])
  @@index([userId, createdAt])
}

// Append-only account/quote versions. A new version never alters an intent.
model PaymentPolicy {
  id               String   @id @default(uuid())
  channel          String
  version          Int
  enabled          Boolean
  account          String
  accountName      String
  pointsNumerator  BigInt
  centsDenominator BigInt
  minCents         BigInt
  maxCents         BigInt
  terms            String
  reviewReference  String
  actorId          String
  createdAt        DateTime @default(now())

  @@unique([channel, version])
}

model PaymentClaim {
  id             String   @id @default(uuid())
  channel        String
  reference      String
  intentId       String   @unique
  userId         String
  amountCents    BigInt
  points         Decimal  @db.Decimal
  receiverSuffix String
  transferredAt  DateTime
  operationId    String   @unique
  journalId      String   @unique
  evidenceHash   String
  createdAt      DateTime @default(now())
  aliases        PaymentTransferAlias[]

  @@unique([channel, reference])
}

model PaymentAttempt {
  id          String   @id @default(uuid())
  intentId    String
  key         String
  requestHash String
  code        String
  evidence    Json
  createdAt   DateTime @default(now())

  @@unique([intentId, key])
}

// An explicit staff-issued credit, never a provider-verified bank receipt.
model AdminWalletCredit {
  id             String   @id @default(uuid())
  intentId       String   @unique
  sourceIntentId String   @unique
  userId         String
  actorId        String
  amountCents    BigInt
  reason         String
  channel        String?
  reference      String?
  operationId    String   @unique
  journalId      String   @unique
  createdAt      DateTime @default(now())

  @@unique([channel, reference])
}

model PaymentTransferAlias {
  id        String       @id @default(uuid())
  channel   String
  alias     String
  claimId   String
  claim     PaymentClaim @relation(fields: [claimId], references: [id], onDelete: Restrict)
  createdAt DateTime     @default(now())

  @@unique([channel, alias])
  @@index([claimId])
}

// A provider submission survives browser closure, timeout, and worker restart.
model VerifyRequest {
  id             String      @id @default(uuid())
  intentId       String
  intent         TopUpIntent @relation(fields: [intentId], references: [id], onDelete: Restrict)
  key            String      @unique
  reference      String
  requestId      String?     @unique
  state          String      @default("SUBMITTING")
  nextCheckAt    DateTime    @default(now())
  attempts       Int         @default(0)
  code           String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([state, nextCheckAt])
  @@index([intentId, createdAt])
}

// Signed webhook events are stored before acknowledgment and processed by a worker.
model VerifyWebhookEvent {
  id          String   @id
  requestId   String
  event       String
  payloadHash String
  processingStatus String?
  createdAt   DateTime @default(now())
  processedAt DateTime?

  @@index([requestId, processedAt])
}

model PaymentStatementEntry {
  id                String   @id @default(uuid())
  channel           String
  reference         String
  amountCents       BigInt
  receiverSuffix    String
  transferredAt     DateTime
  evidenceReference String
  status            String
  intentId          String?
  actorId           String
  createdAt         DateTime @default(now())

  @@index([status, createdAt])
}

model BotUpdate {
  botId         String?
  updateId      BigInt    @id
  payload       Json
  receivedAt    DateTime  @default(now())
  processedAt   DateTime?
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lastError     String?
}

model Outbox {
  id              String             @id @default(uuid())
  key             String             @unique
  kind            String
  payload         Json
  createdAt       DateTime           @default(now())
  sentAt          DateTime?
  state           String             @default("PENDING")
  attempts        Int                @default(0)
  nextAttemptAt   DateTime           @default(now())
  lastError       String?
  settlementId    String?
  settlement      AuctionSettlement? @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  testRunId       String?
  testRun         TestRun?           @relation(fields: [testRunId], references: [id], onDelete: Restrict)
  telegramMessage TelegramMessage?

  @@index([testRunId, state])
}

// Private immutable decision and audit proof. PublicAuctionResult is the separate
// Phase 2 illustrative catalog projection; closing never edits or adopts it.
model AuctionSettlement {
  id               String               @id @default(uuid())
  auctionId        String               @unique
  auction          Auction              @relation(fields: [auctionId], references: [id], onDelete: Restrict)
  outcome          String
  ruleVersion      String
  termsVersion     Int
  cutoff           DateTime             @db.Timestamp(6)
  completedAt      DateTime             @default(dbgenerated("(clock_timestamp() AT TIME ZONE 'UTC')")) @db.Timestamp(6)
  transactionId    BigInt               @default(dbgenerated("txid_current()"))
  acceptedCount    Int
  decision         String?
  participantCount Int?
  acceptanceCutoff BigInt?
  winnerUserId     String?
  winner           User?                @relation("SettlementWinner", fields: [winnerUserId], references: [id], onDelete: Restrict)
  winningBidId     String?              @unique
  winningBid       Bid?                 @relation(fields: [winningBidId], references: [id], onDelete: Restrict)
  winningPoints    Decimal?             @db.Decimal
  actorId          String?
  reason           String?
  key              String?
  requestHash      String?
  proof            Json
  movements        SettlementMovement[]
  outbox           Outbox[]
  publication      ResultPublication?

  @@unique([actorId, key])
}

// Announcement approval is separate from immutable financial settlement.
// No winner, bid or amount override is accepted by the publication command.
model ResultPublication {
  settlementId String            @id
  settlement   AuctionSettlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  publishedAt  DateTime          @default(dbgenerated("(clock_timestamp() AT TIME ZONE 'UTC')")) @db.Timestamp(6)
  actorId      String?
  proofHash    String
  reason       String
  historical   Boolean           @default(false)
}

model SettlementMovement {
  id                 String            @id @default(uuid())
  settlementId       String
  settlement         AuctionSettlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  userId             String
  user               User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  walletId           String
  wallet             Wallet            @relation(fields: [walletId], references: [id], onDelete: Restrict)
  holdBefore         Decimal           @db.Decimal
  chargedPoints      Decimal           @db.Decimal
  releasedPoints     Decimal           @db.Decimal
  refundedFees       Decimal           @db.Decimal
  chargeOperationId  String?           @unique
  chargeOperation    Operation?        @relation("SettlementCharge", fields: [chargeOperationId], references: [id], onDelete: Restrict)
  releaseOperationId String?           @unique
  releaseOperation   Operation?        @relation("SettlementRelease", fields: [releaseOperationId], references: [id], onDelete: Restrict)
  refundOperationId  String?           @unique
  refundOperation    Operation?        @relation("SettlementRefund", fields: [refundOperationId], references: [id], onDelete: Restrict)

  @@unique([settlementId, userId])
}

// Display-only settings are deliberately separate from Better Auth identity.
model PlayerProfile {
  userId      String   @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  displayName String
  bio         String   @default("")
  contactEmail String?
  city         String?
  updatedAt   DateTime @updatedAt
}

// Referral policy changes affect future grants only. Earned rewards snapshot
// their percentage and expiry and never become transferable voucher codes.
model ReferralPolicy {
  id              String   @id @default("default")
  enabled         Boolean  @default(false)
  discountPercent Int      @default(10)
  expiryDays      Int      @default(30)
  version         Int      @default(1)
  updatedBy       String?
  updatedAt       DateTime @updatedAt
}

model ReferralInvite {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  token     String   @unique
  createdAt DateTime @default(now())
}

// A private, trusted bot /start event can precede contact registration.
// Existing customers can never create or consume a new pending attribution.
model ReferralPendingSignup {
  id             String   @id @default(uuid())
  botId          String
  telegramId     String
  referrerUserId String
  referrer       User     @relation("PendingReferralSponsor", fields: [referrerUserId], references: [id], onDelete: Restrict)
  consumedUserId String?  @unique
  consumedUser   User?    @relation("PendingReferralUser", fields: [consumedUserId], references: [id], onDelete: Restrict)
  createdAt      DateTime @default(now())
  renewedAt      DateTime?
  expiresAt      DateTime
  signup         ReferralSignup?

  @@unique([botId, telegramId])
}

// Internal server registration proof: inserted by the user INSERT trigger,
// never backfilled for existing accounts or accepted from the browser.
model ReferralRegistrationProof {
  userId        String @id
  user          User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  transactionId BigInt @default(dbgenerated("txid_current()"))
  registeredAt  DateTime @default(dbgenerated("(clock_timestamp() AT TIME ZONE 'UTC')"))
}

model ReferralSignup {
  referredUserId String @id
  referredUser   User   @relation("ReferralNewUser", fields: [referredUserId], references: [id], onDelete: Restrict)
  referrerUserId String
  referrer       User   @relation("ReferralSponsor", fields: [referrerUserId], references: [id], onDelete: Restrict)
  pendingId      String? @unique
  pending        ReferralPendingSignup? @relation(fields: [pendingId], references: [id], onDelete: Restrict)
  registeredAt  DateTime @default(now())
  firstBidId     String? @unique
  firstBid       Bid?   @relation("ReferralFirstBid", fields: [firstBidId], references: [id], onDelete: Restrict)
  qualifiedAt   DateTime?
  coupon        ReferralCoupon?

  @@index([referrerUserId, registeredAt])
}

model ReferralCoupon {
  id              String @id @default(uuid())
  ownerUserId     String
  owner           User   @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  referredUserId  String @unique
  signup          ReferralSignup @relation(fields: [referredUserId], references: [referredUserId], onDelete: Restrict)
  percent         Int
  policyVersion   Int
  createdAt       DateTime @default(now())
  expiresAt       DateTime
  redemption      ReferralRedemption?

  @@index([ownerUserId, expiresAt])
}

// One coupon can sponsor one accepted v4 submission fee. Its journal is a
// contra-fee movement; it is never a deposit or a reusable wallet credit.
model ReferralRedemption {
  id              String @id @default(uuid())
  couponId        String @unique
  coupon          ReferralCoupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  userId          String
  user            User @relation(fields: [userId], references: [id], onDelete: Restrict)
  bidId           String @unique
  bid             Bid @relation(fields: [bidId], references: [id], onDelete: Restrict)
  operationId     String @unique
  operation       Operation @relation(fields: [operationId], references: [id], onDelete: Restrict)
  grossFeePoints  Decimal @db.Decimal
  discountPoints  Decimal @db.Decimal
  createdAt       DateTime @default(now())
}

model AuctionFavorite {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  auctionId String
  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@id([userId, auctionId])
  @@index([userId, createdAt])
  @@index([auctionId])
}

model StaffMember {
  userId         String   @id
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  role           String   @default("OWNER")
  active         Boolean  @default(true)
  secret         String?
  lastCounter    BigInt               @default(-1)
  recoveryHashes String[]
  createdAt      DateTime @default(now())
}

model StaffSession {
  sessionId         String              @id
  session           Session             @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  credentialAt      DateTime
  authMethod        String              @default("legacy")
  mfaAt             DateTime?
  expiresAt         DateTime
  pendingSecret     String?
  trustedDeviceHash String?
}

model AdminAudit {
  id           String   @id @default(uuid())
  actorId      String
  action       String
  target       String
  details      Json
  operationKey String?  @unique
  requestHash  String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

model AuctionDraft {
  auctionId String   @id
  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: Restrict)
  version   Int      @default(1)
  body      Json
  updatedAt DateTime @updatedAt
}

model ManagedMedia {
  id           String   @id @default(uuid())
  bytes        Bytes
  mime         String
  sourceType   String
  sourceCredit String
  purpose      String   @default("CATALOG")
  createdAt    DateTime @default(now())
  winnerPresentations WinnerPresentation[]
}

// Editable announcement media stays separate from immutable auction/result facts.
model WinnerPresentation {
  auctionId          String @id
  auction            Auction @relation(fields: [auctionId], references: [id], onDelete: Restrict)
  imageId            String?
  image              ManagedMedia? @relation(fields: [imageId], references: [id], onDelete: Restrict)
  consentConfirmedAt DateTime?
  consentActorId     String?
  consentActor       User? @relation("WinnerPhotoConsent", fields: [consentActorId], references: [id], onDelete: Restrict)
  version            Int @default(1)
  updatedAt          DateTime @updatedAt

  @@index([imageId])
}

model SiteContent {
  id        String   @id
  version   Int      @default(1)
  body      Json
  updatedAt DateTime @updatedAt
}

model UserRestriction {
  userId    String   @id
  suspended Boolean  @default(false)
  reason    String
  updatedAt DateTime @updatedAt
}

model FulfillmentCase {
  auctionId       String    @id
  userId          String
  assignedTo      String?
  state           String    @default("PENDING")
  contactCipher   String?
  tracking        String    @default("")
  note            String    @default("")
  version         Int       @default(1)
  deliveredAt     DateTime?
  contactDeleteAt DateTime?
  testRunId       String?
  testRun         TestRun?  @relation(fields: [testRunId], references: [id], onDelete: Restrict)
  updatedAt       DateTime  @updatedAt

  @@index([testRunId])
}

model NotificationPreference {
  userId         String  @id
  inApp          Boolean @default(true)
  telegram       Boolean @default(false)
  auctionStart   Boolean @default(true)
  favoriteEnding Boolean @default(true)
  fulfillment    Boolean @default(true)
}

model NotificationInbox {
  id        String    @id @default(uuid())
  key       String    @unique
  userId    String
  kind      String
  title     String
  body      String
  href      String
  readAt    DateTime?
  testRunId String?
  testRun   TestRun?  @relation(fields: [testRunId], references: [id], onDelete: Restrict)
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([testRunId])
}

// Populated only from authenticated webhook /start updates, never a browser ID.
model BotChat {
  telegramId String   @id
  chatId     String   @unique
  startedAt  DateTime @default(now())
  blocked    Boolean  @default(false)
}

model TelegramMessage {
  id                  String    @id @default(uuid())
  outboxId            String    @unique
  outbox              Outbox    @relation(fields: [outboxId], references: [id], onDelete: Restrict)
  auctionId           String?
  testRunId           String?
  chatId              String
  messageId           BigInt
  sentAt              DateTime  @default(now())
  deletionState       String    @default("DELIVERED")
  deletionRequestedAt DateTime?
  deletionAttemptedAt DateTime?
  deletionError       String?

  @@index([auctionId, deletionState])
  @@index([testRunId, deletionState])
}

model TestRun {
  id               String              @id @default(uuid())
  state            String              @default("DRAFT")
  label            String
  actorId          String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  finishedAt       DateTime?
  cleanupStartedAt DateTime?
  cleanedAt        DateTime?
  auctions         Auction[]
  products         Product[]
  actors           TestRunActor[]
  outbox           Outbox[]
  inbox            NotificationInbox[]
  fulfillment      FulfillmentCase[]

  @@index([state, createdAt])
}

model TestRunActor {
  testRunId String
  testRun   TestRun @relation(fields: [testRunId], references: [id], onDelete: Restrict)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  label     String

  @@id([testRunId, userId])
  @@index([userId])
}
