[Unit]
Description=Lowwin %i
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=lowwin
Group=lowwin
WorkingDirectory=/srv/lowwin/current
EnvironmentFile=/etc/lowwin/runtime.env
EnvironmentFile=/etc/lowwin/%i.env
ExecStart=/usr/bin/node /srv/lowwin/current/deploy/service.mjs %i
Restart=on-failure
RestartSec=5
TimeoutStopSec=150
KillSignal=SIGTERM
KillMode=mixed
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/lowwin/shared /srv/lowwin/current/.next/cache
UMask=0077
MemoryMax=1536M
CPUQuota=100%
TasksMax=128
LimitNOFILE=4096
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
