# Add to the EXISTING TLS proxy; never replace Gojo's listeners/vhosts.
# These shared-memory zones belong inside nginx's http {} context.
limit_req_zone $binary_remote_addr zone=lowwin_api:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=lowwin_auth:10m rate=2r/s;
upstream lowwin_web { server 127.0.0.1:3210; keepalive 16; }
server {
    listen 443 ssl;
    server_name LOWWIN_DOMAIN;
    ssl_certificate /etc/letsencrypt/live/LOWWIN_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/LOWWIN_DOMAIN/privkey.pem;
    client_max_body_size 64k;
    client_body_timeout 15s;
    limit_req_status 429;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    # Telegram Web clients embed the Mini App: do not add DENY/X-Frame-Options.
    add_header Content-Security-Policy "frame-ancestors 'self' https://web.telegram.org https://*.telegram.org" always;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_http_version 1.1;
    proxy_read_timeout 150s;
    location /api/auth/ { limit_req zone=lowwin_auth burst=10 nodelay; proxy_pass http://lowwin_web; }
    location = /api/wallet/scan { client_max_body_size 6m; limit_req zone=lowwin_api burst=10 nodelay; proxy_pass http://lowwin_web; }
    # Images are base64 inside the authenticated admin command envelope.
    location = /api/admin/command { client_max_body_size 3m; limit_req zone=lowwin_api burst=10 nodelay; proxy_pass http://lowwin_web; }
    location /api/ { limit_req zone=lowwin_api burst=30 nodelay; proxy_pass http://lowwin_web; }
    location / { proxy_pass http://lowwin_web; }
}
