NODE_ENV=production
APP_ENV=production
RAILPACK_NODE_VERSION=24
RAILPACK_PRUNE_DEPS=false
DATABASE_URL=<RESTRICTED_SUPABASE_TRANSACTION_POOL_URL>
DIRECT_URL=<SAME_RESTRICTED_RUNTIME_URL>
BETTER_AUTH_URL=https://lowwin.shop
MINI_APP_URL=https://lowwin.shop/telegram
BETTER_AUTH_SECRET=<NEW_BASE64URL_SECRET>
TELEGRAM_BOT_TOKEN=<BOTFATHER_TOKEN>
TELEGRAM_BOT_USERNAME=<USERNAME_WITHOUT_AT>
TELEGRAM_WEBHOOK_SECRET=<NEW_BASE64URL_SECRET>
PHONE_CONTACT_KEY_ID=phone-v1
PHONE_CONTACT_KEYS={"phone-v1":"<NEW_64_HEX_KEY>"}
PHONE_CONTACT_HASH_KEY=<NEW_SEPARATE_64_HEX_KEY>
ADMIN_MFA_KEY=<NEW_SEPARATE_64_HEX_KEY>
DELIVERY_CONTACT_KEY_ID=delivery-v1
DELIVERY_CONTACT_KEYS={"delivery-v1":"<NEW_SEPARATE_64_HEX_KEY>"}
EMAIL_TRANSPORT=resend
EMAIL_FROM=<VERIFIED_SENDER_EMAIL>
RESEND_API_KEY=<RESEND_API_KEY>
VERIFY_ET_API_KEY=<VERIFY_ET_API_KEY>
VERIFY_ET_WEBHOOK_SECRET=<VERIFY_ET_WHSEC_SECRET>
VERIFY_ET_SCHEMA_READY=false
VERIFY_ET_IMAGE_PROCESSING=false
PAYMENTS_LIVE_ENABLED=false
REDIS_URL=<LOWWIN_REDIS_INTERNAL_URL>
REDIS_CACHE_NAMESPACE=lowwin-production
LOWWIN_MEDIA_CACHE_DIR=/srv/lowwin/shared/media-cache
ADMIN_BOOTSTRAP_ENABLED=false
DEV_IDENTITY_ENABLED=false
DEV_POINTS_ENABLED=false
STAGING_DEMO_ENABLED=false
PAYMENTS_TEST_ENABLED=false
WALLET_TEST_PREVIEW=false
