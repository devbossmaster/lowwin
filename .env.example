# Local shell works without credentials; authenticated routes require all values below.
APP_ENV=local
DATABASE_URL=postgresql://lowin:CHANGE_ME@127.0.0.1:5432/lowin
DIRECT_URL=postgresql://lowin:CHANGE_ME@127.0.0.1:5432/lowin
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
TELEGRAM_BOT_TOKEN=123456789:REPLACE_WITH_BOTFATHER_TOKEN
TELEGRAM_BOT_USERNAME=your_lowin_bot
TELEGRAM_WEBHOOK_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
MINI_APP_URL=http://localhost:3000
DEV_IDENTITY_ENABLED=false
DEV_POINTS_ENABLED=false
# Only for the opt-in disposable integration suite; never point at a shared database.
TEST_DATABASE_URL=postgresql://lowin_test@127.0.0.1:55439/lowin_test
