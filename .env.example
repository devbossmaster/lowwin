# Lowwin configuration inventory. Never put real values in this file.
# Copy to untracked .env locally. See docs/production-setup.md.
# Required unless marked optional/conditional/test. Staging and production must
# have separate databases, bots, origins, keys, accounts and email configuration.
APP_ENV=local
# Production activation only AFTER release/receiver review and approved transfer.
# Leave false for every staging/local service. Never enable via a browser/admin role.
PAYMENTS_LIVE_ENABLED=false
# Optional local restore rehearsal only: directory containing pg_dump/pg_restore.
# Windows example: C:/Program Files/PostgreSQL/17/bin; omit when tools are on PATH.
PG_BIN=
# Normally set by next dev/build/start, not manually overridden.
NODE_ENV=development

# Restricted SERVER runtime login, never postgres/service_role/anon.
# Supabase transaction pool 6543: add sslmode=require&pgbouncer=true.
# Budget 5 connections per web process + 1 per worker against the project limit.
DATABASE_URL=postgresql://lowwin_runtime:CHANGE_ME@127.0.0.1:5432/lowwin?connection_limit=5&connect_timeout=15&pool_timeout=20
# Persistent KVM/Coolify volume. Published images are read from PostgreSQL once,
# then served from this local cache instead of consuming repeated database egress.
LOWWIN_MEDIA_CACHE_DIR=/srv/lowwin/shared/media-cache
# Optional shared PUBLIC catalog/result cache. Use Coolify's internal Redis URL.
# Never expose Redis publicly or share Gojo's Redis instance.
REDIS_URL=
REDIS_CACHE_NAMESPACE=lowwin-production
# Migration jobs only: separate schema-owner direct/session connection on 5432.
# Web/worker config may use the runtime URL here to satisfy presence validation;
# inject the privileged migration URL only when running reviewed migrations.
DIRECT_URL=postgresql://lowwin_migration:CHANGE_ME@127.0.0.1:5432/lowwin
BETTER_AUTH_URL=http://localhost:3000
MINI_APP_URL=http://localhost:3000/telegram
# Random >=32 characters; rotate only with planned session invalidation.
BETTER_AUTH_SECRET=REPLACE_WITH_RANDOM_BASE64URL_SECRET
TELEGRAM_BOT_TOKEN=123456789:REPLACE_WITH_BOTFATHER_TOKEN
TELEGRAM_BOT_USERNAME=your_lowwin_bot
TELEGRAM_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_BASE64URL_SECRET

# Contact onboarding: independent 32-byte hex keys; retain old key IDs.
PHONE_CONTACT_KEY_ID=phone-v1
PHONE_CONTACT_KEYS={"phone-v1":"REPLACE_WITH_64_HEX_CHARACTERS"}
# Stable lookup HMAC: changing this requires a reviewed data migration.
PHONE_CONTACT_HASH_KEY=REPLACE_WITH_SEPARATE_64_HEX_CHARACTERS
# Required for staff MFA; back up securely with the database.
ADMIN_MFA_KEY=REPLACE_WITH_SEPARATE_64_HEX_CHARACTERS
# Required for fulfillment contact; separate from phone and MFA keys.
DELIVERY_CONTACT_KEY_ID=delivery-v1
DELIVERY_CONTACT_KEYS={"delivery-v1":"REPLACE_WITH_SEPARATE_64_HEX_CHARACTERS"}

# Conditional staff email: unavailable | resend | local-sink.
# Production uses resend with a verified sender domain. No failure fallback.
EMAIL_TRANSPORT=unavailable
EMAIL_FROM=staff@example.invalid
RESEND_API_KEY=
# Local disposable tests only; never real delivery.
EMAIL_SINK_URL=http://127.0.0.1:8027
EMAIL_SINK_PORT=8027
# One-time CLI only; always false in normal web and worker configuration.
ADMIN_BOOTSTRAP_ENABLED=false

# Live crediting requires PAYMENTS_LIVE_ENABLED, a completed migration,
# VERIFY_ET_SCHEMA_READY=true, and reviewed provider policies.
# Keep false during deployment validation and until controlled activation approval.
VERIFY_ET_API_KEY=
# Dashboard endpoint secret; use the previous value only during the rotation window.
VERIFY_ET_WEBHOOK_SECRET=
VERIFY_ET_WEBHOOK_SECRET_PREVIOUS=
VERIFY_ET_SCHEMA_READY=false
PAYMENTS_TEST_ENABLED=false
# Optional: disabled | tesseract; OCR extracts a reference, never proves payment.
RECEIPT_OCR=disabled
VERIFY_ET_IMAGE_PROCESSING=false
# Test-only localhost provider mock; empty otherwise.
VERIFY_ET_TEST_ENDPOINT=
WALLET_TEST_PREVIEW=false

# Direct ArifPay bid-fee checkout. Keep OFF until an independently reviewed release.
# These switches do not activate Verify.et or change PAYMENTS_LIVE_ENABLED.
ARIFPAY_ENABLED=false
# Allow existing pending orders to reconcile while new checkout creation is paused.
ARIFPAY_RECOVERY_ENABLED=false
ARIFPAY_SCHEMA_READY=false
ARIFPAY_MERCHANT_REVIEWED=false
ARIFPAY_BASE_URL=https://gateway.arifpay.net
ARIFPAY_CURRENCY=ETB
# Optional comma-separated server user IDs / auction slugs for a controlled canary.
# Recovery of already-created orders is never blocked by these allowlists.
ARIFPAY_CANARY_USER_IDS=
ARIFPAY_CANARY_AUCTION_SLUGS=
ARIFPAY_API_KEY=
# Independent >=32-character random callback URL token; never a NEXT_PUBLIC value.
ARIFPAY_WEBHOOK_TOKEN=
# Disposable loopback *_test PostgreSQL only, for the integration test suite.
ARIFPAY_TEST_DATABASE_URL=

# Chapa API v2 hosted checkout. Selection does not activate payments.
# Setup: docs/payments/chapa-v2.md. Fill the private key and webhook secret below
# when your merchant account is ready; keep all enabled/live flags false until tested.
# Keep disabled until reviewed migrations, merchant test verification and release.
# Never enable legacy PAYMENTS_LIVE_ENABLED / Verify.et merely to use Chapa.
PAYMENT_GATEWAY=CHAPA
CHAPA_ENABLED=false
# Enables durable webhook processing and verification of existing payments,
# including while new checkouts are paused. The event worker still needs this.
CHAPA_RECOVERY_ENABLED=false
# Optional, explicitly bounded pre-v2 compatibility only; new attempts are excluded.
CHAPA_LEGACY_SWEEP_ENABLED=false
CHAPA_SCHEMA_READY=false
CHAPA_MODE=test
CHAPA_BASE_URL=https://api.chapa.global
CHAPA_CURRENCY=ETB
# Server-only CHAPA_TEST_... or CHAPA_LIVE_... private key; no NEXT_PUBLIC key.
CHAPA_PRIVATE_KEY=
# Required in Signature mode: independent >=32-character webhook secret.
CHAPA_WEBHOOK_SECRET=
# Explicit dashboard authentication. Default signature retains raw-body HMAC.
# For Basic Auth use HTTPS and a separate random password (16-256 characters).
# Basic mode uses its username/password; the signature secret is optional.
CHAPA_WEBHOOK_AUTH=signature
CHAPA_WEBHOOK_BASIC_USERNAME=
CHAPA_WEBHOOK_BASIC_PASSWORD=
# Test mode must never target the live service. Required for a remote staging DB.
CHAPA_TEST_ENVIRONMENT_REVIEWED=false
# Live mode additionally requires production environment and explicit review.
CHAPA_LIVE_ENABLED=false
CHAPA_MERCHANT_REVIEWED=false
# Optional operator-only, short-lived recovery JSON emitted after a fresh
# authenticated verification by scripts/authorize-chapa-recovery.ts. A matching
# immutable audit is also required. Never use this to reinitialize an old intent.
CHAPA_RECOVERY_BINDINGS=
# Wallet submissions use existing funds and the authoritative frozen fee command.
# This switch does not enable any provider or create customer funds.
WALLET_BIDS_ENABLED=false
# Production additionally requires this separate wallet-spending review.
WALLET_BIDS_LIVE_ENABLED=false
# Integration runner only: disposable loopback *_test database, never Supabase.
CHAPA_TEST_DATABASE_URL=

# Local-only features; never enable on ngrok, remote DB or production.
DEV_IDENTITY_ENABLED=false
DEV_IDENTITY_ACCESS_KEY=
DEV_POINTS_ENABLED=false
# Conditional guarded staging DEMO capability, explicitly allowlisted testers.
# Hashes bind the staging bot and origin. DEMO ETB has no cash value.
STAGING_DEMO_ENABLED=false
STAGING_DEMO_BOT_HASH=
STAGING_DEMO_ORIGIN_HASH=
STAGING_DEMO_USER_IDS=

# Enable only after the additive referral migration and reconciliation checks.
# Percentage (5-15) and validity (15-30 days) are configured in Admin, not here.
# This does not enable Wallet or Chapa payments.
REFERRAL_REWARDS_SCHEMA_READY=false

# Test runner only: disposable loopback *_test database. run-db-tests creates
# fresh per-suite databases without dropping/resetting any existing database.
TEST_DATABASE_URL=postgresql://lowin_test:fixture_only@127.0.0.1:5432/lowin_test
BID_TEST_DATABASE_URL=
SETTLEMENT_TEST_DATABASE_URL=
PERSONAL_TEST_DATABASE_URL=
ADMIN_TEST_DATABASE_URL=
OPS_TEST_DATABASE_URL=
PAYMENT_TEST_DATABASE_URL=
# Browser fixture only: local | tunnel | payments; empty normally.
LOWIN_UI_TEST_MODE=
LOWWIN_PLAYWRIGHT_CHANNEL=

# Platform-owned optional variables: VERCEL (hosted guard), PATH/SystemRoot
# (process execution), PORT/HOSTNAME (Next runtime). Never invent VERCEL locally.
# No NEXT_PUBLIC secret, Supabase anon/service-role key, SMTP password or payment
# browser-visible activation switch is used. PAYMENTS_LIVE_ENABLED is server-only.

# Optional actual Lowin tutorial, https://www.youtube.com/watch?v=... or https://youtu.be/...
LOWIN_YOUTUBE_URL=

# Optional same-origin tutorial media; local video takes precedence over YouTube.
LOWIN_HOW_TO_VIDEO_PATH=
LOWIN_HOW_TO_POSTER_PATH=
