# Local shell works without credentials; authenticated routes require all values below.
APP_ENV=local
DATABASE_URL=postgresql://lowin:CHANGE_ME@127.0.0.1:5432/lowin
DIRECT_URL=postgresql://lowin:CHANGE_ME@127.0.0.1:5432/lowin
# Hosted Supabase app: use the Connect panel's transaction pool URL on port 6543.
# Add ?sslmode=require&pgbouncer=true&connection_limit=5&connect_timeout=15&pool_timeout=20
# Keep DIRECT_URL on the direct/session endpoint for Prisma migrations.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
TELEGRAM_BOT_TOKEN=123456789:REPLACE_WITH_BOTFATHER_TOKEN
TELEGRAM_BOT_USERNAME=your_lowin_bot
TELEGRAM_WEBHOOK_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
MINI_APP_URL=http://localhost:3000
DEV_IDENTITY_ENABLED=false
# Private random 32–256 character operator key, manually entered locally.
# Never expose in NEXT_PUBLIC_*, HTML, URLs or browser storage. Required only if enabled.
DEV_IDENTITY_ACCESS_KEY=
DEV_POINTS_ENABLED=false
# Only for the opt-in disposable integration suite; never point at a shared database.
TEST_DATABASE_URL=postgresql://lowin_test@127.0.0.1:55439/lowin_test
# Separate fresh bid fixtures; enable this together with TEST_DATABASE_URL for the full suite.
BID_TEST_DATABASE_URL=postgresql://lowin_test@127.0.0.1:55439/lowin_bid_test
# Optional separation for settlement fixtures; defaults to BID_TEST_DATABASE_URL.
SETTLEMENT_TEST_DATABASE_URL=postgresql://lowin_test@127.0.0.1:55439/lowin_settlement_test
# Separate Phase 4B public-result and private-profile fixtures; set all four for the full suite.
PERSONAL_TEST_DATABASE_URL=postgresql://lowin_test@127.0.0.1:55439/lowin_personal_test
# Phase 5A: distinct disposable database; never use the application database here.
ADMIN_TEST_DATABASE_URL=postgresql://lowin_test@127.0.0.1:55439/lowin_admin_test
# Server-only AES-256 key: exactly 64 random hex characters. Back up securely.
ADMIN_MFA_KEY=
# Enable only while executing the audited first-Owner CLI, then disable.
ADMIN_BOOTSTRAP_ENABLED=false
# No production email provider is implemented. local-sink requires APP_ENV local/test,
# NODE_ENV != production, a loopback *_test DATABASE_URL and loopback HTTP sink.
EMAIL_TRANSPORT=unavailable
EMAIL_SINK_URL=http://127.0.0.1:8027

# Isolated loopback _test databases only; synthetic non-payable wallet references.
WALLET_TEST_PREVIEW=false
# Worker: npm run worker:notifications (opt-in private chats only).
OPS_TEST_DATABASE_URL=postgresql://lowin_test@127.0.0.1:55439/lowin_ops_test

# Phase 6: production credit path is deliberately disabled in code.
PAYMENTS_TEST_ENABLED=false
CHECK_ET_MODE=test
CHECK_ET_TEST_API_KEY=
CHECK_ET_LIVE_API_KEY=
RECEIPT_OCR=tesseract
# Dedicated delivery-contact keyring; keep previous keys until rotation/restore is verified.
DELIVERY_CONTACT_KEY_ID=
DELIVERY_CONTACT_KEYS=
# PAYMENT_TEST_DATABASE_URL=postgresql://...@127.0.0.1:55439/lowin_payments_test
